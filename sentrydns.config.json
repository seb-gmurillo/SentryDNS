{
  "service": {
    "name": "SentryDNS",
    "logPath": "C:\\ProgramData\\SentryDNS\\logs\\sentrydns.log"
  },

  "network": {
    "probeIntervalSeconds": 300,
    "dnsTimeoutMs": 800,
    "hardFailMs": 750,
    "maxConsecutiveFails": 3,
    "backoffCap": 8,
    "minHoldSeconds": 180
  },

  "control": {
    "tauSeconds": 1800,
    "switchBiasMs": 15,
    "epsilon": 0.001
  },

  "anomaly": {
    "enabled": true,
    "zThreshold": 4.0,
    "maxAnomalies": 5
  },

  "scoring": {
    "weights": {
      "latency": 0.6,
      "variance": 0.25,
      "failure": 0.15
    }
  },

  "stability": {
    "weights": {
      "variance": 0.5,
      "failure": 0.3,
      "anomaly": 0.2
    }
  },

  "http": {
    "enabled": true,
    "port": 9787
  },

  "providers": [
    { "name": "AdGuard-Std",      "v4": "94.140.14.140", "v6": "2a10:50c0::1:ff" },
    { "name": "AdGuard-Ads",      "v4": "94.140.14.14",  "v6": "2a10:50c0::ad1:ff" },
    { "name": "ControlD-Std",     "v4": "76.76.2.0",     "v6": "76.76.10.0" },
    { "name": "ControlD-Malware", "v4": "76.76.2.2",     "v6": "76.76.10.2" },
    { "name": "Quad9-Sec",        "v4": "9.9.9.9",       "v6": "2620:fe::fe" },
    { "name": "Cloudflare-Std",   "v4": "1.1.1.1",       "v6": "2606:4700:4700::1111" },
    { "name": "Mullvad-Std",      "v4": "194.242.2.4",   "v6": "2a07:e340::4" }
  ]
}